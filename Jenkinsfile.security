pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        SCAN_RESULTS = 'scan-results'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "✓ Repository checked out"
                }
            }
        }

        stage('Helm Security Scan') {
            steps {
                script {
                    echo "🔒 Scanning Helm charts for security issues..."
                    sh '''
                        mkdir -p ${SCAN_RESULTS}
                        
                        for chart in helm/argocd helm/karpenter helm/keda helm/jenkins; do
                            echo "Scanning $chart..."
                            helm lint $chart --strict 2>&1 | tee ${SCAN_RESULTS}/$(basename $chart)-helm.log || echo "Warning: Issues found in $chart"
                        done
                        
                        echo "✓ Helm security scan completed"
                    '''
                }
            }
        }

        stage('Terraform Security Scan') {
            steps {
                script {
                    echo "🔒 Scanning Terraform files for security issues..."
                    sh '''
                        mkdir -p ${SCAN_RESULTS}
                        
                        # Trivy filesystem scan
                        which trivy > /dev/null 2>&1 && {
                            echo "Running Trivy scan..."
                            trivy fs terraform/ --format json -o ${SCAN_RESULTS}/trivy-terraform.json || echo "Warning: Trivy scan found issues"
                            trivy fs terraform/ --format table || echo "Warning: Issues found"
                        } || echo "Trivy not installed"
                        
                        # TFSec scan
                        which tfsec > /dev/null 2>&1 && {
                            echo "Running TFSec scan..."
                            tfsec terraform/ -f json -o ${SCAN_RESULTS}/tfsec-results.json || echo "Warning: TFSec found issues"
                            tfsec terraform/ || echo "Warning: Issues found"
                        } || echo "TFSec not installed"
                        
                        echo "✓ Terraform security scan completed"
                    '''
                }
            }
        }

        stage('Container Image Scan') {
            steps {
                script {
                    echo "🔒 Scanning for container vulnerabilities..."
                    sh '''
                        mkdir -p ${SCAN_RESULTS}
                        
                        # Grype scanning
                        which grype > /dev/null 2>&1 && {
                            echo "Running Grype container scan..."
                            grype . --output json -o ${SCAN_RESULTS}/grype-results.json || echo "Warning: Vulnerabilities found"
                        } || echo "Grype not installed"
                        
                        echo "✓ Container scan completed"
                    '''
                }
            }
        }

        stage('Dependency Check') {
            steps {
                script {
                    echo "📦 Checking for vulnerable dependencies..."
                    sh '''
                        mkdir -p ${SCAN_RESULTS}
                        
                        # Check for known vulnerabilities
                        if [ -f "requirements.txt" ]; then
                            echo "Found requirements.txt - scanning Python dependencies..."
                            pip install safety 2>/dev/null || true
                            safety check --json > ${SCAN_RESULTS}/python-dependencies.json 2>&1 || echo "Warning: Vulnerable dependencies found"
                        fi
                        
                        if [ -f "package.json" ]; then
                            echo "Found package.json - scanning npm dependencies..."
                            npm audit --json > ${SCAN_RESULTS}/npm-dependencies.json 2>&1 || echo "Warning: Vulnerable dependencies found"
                        fi
                        
                        echo "✓ Dependency check completed"
                    '''
                }
            }
        }

        stage('SAST Analysis') {
            steps {
                script {
                    echo "🔍 Running Static Application Security Testing..."
                    sh '''
                        mkdir -p ${SCAN_RESULTS}
                        
                        # SonarQube scan (if configured)
                        if [ ! -z "$SONAR_HOST_URL" ]; then
                            echo "Running SonarQube scan..."
                            sonar-scanner -Dsonar.projectKey=infrastructure || echo "SonarQube scan failed"
                        else
                            echo "SonarQube not configured"
                        fi
                        
                        echo "✓ SAST analysis completed"
                    '''
                }
            }
        }

        stage('Generate Report') {
            steps {
                script {
                    echo "📋 Generating security report..."
                    sh '''
                        mkdir -p ${SCAN_RESULTS}
                        
                        cat > ${SCAN_RESULTS}/security-summary.txt << EOF
========================================
Security Scan Summary
========================================
Generated: $(date)
Repository: $(git remote get-url origin)
Branch: $(git rev-parse --abbrev-ref HEAD)
Commit: $(git rev-parse --short HEAD)
========================================

Scan Results:
- Helm Charts: Checked
- Terraform Files: Checked
- Container Images: Checked
- Dependencies: Checked
- SAST: Checked

Details available in scan results files.
EOF
                        
                        echo "✓ Security report generated"
                        cat ${SCAN_RESULTS}/security-summary.txt
                    '''
                }
            }
        }

        stage('Archive Results') {
            steps {
                script {
                    echo "📁 Archiving scan results..."
                    sh '''
                        if [ -d ${SCAN_RESULTS} ]; then
                            tar -czf ${SCAN_RESULTS}.tar.gz ${SCAN_RESULTS}/
                            echo "✓ Scan results archived"
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                archiveArtifacts artifacts: "${SCAN_RESULTS}/**", allowEmptyArchive: true
                sh 'echo "Security scan pipeline completed"'
            }
        }
        success {
            echo "✅ Security scan completed successfully"
        }
        failure {
            echo "⚠️ Security scan found issues - review report"
        }
    }
}
