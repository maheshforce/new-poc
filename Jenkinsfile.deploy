pipeline {
    agent any
    
    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    environment {
        AWS_REGION = 'us-east-1'
        KUBECONFIG = '/tmp/kubeconfig'
    }
    
    parameters {
        string(name: 'EKS_CLUSTER_NAME', defaultValue: '', description: 'EKS Cluster Name')
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'staging', 'prod'], description: 'Deployment Environment')
        booleanParam(name: 'SKIP_KARPENTER', defaultValue: false, description: 'Skip Karpenter deployment')
        booleanParam(name: 'SKIP_KEDA', defaultValue: false, description: 'Skip KEDA deployment')
        booleanParam(name: 'SKIP_ARGOCD', defaultValue: false, description: 'Skip ArgoCD deployment')
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.BUILD_DESCRIPTION = "Env: ${params.DEPLOY_ENV} | Cluster: ${params.EKS_CLUSTER_NAME}"
                }
            }
        }
        
        stage('Prerequisites') {
            steps {
                script {
                    echo "Checking prerequisites..."
                    sh '''
                        which aws || (echo "AWS CLI not found" && exit 1)
                        which kubectl || (echo "kubectl not found" && exit 1)
                        which helm || (echo "Helm not found" && exit 1)
                        
                        aws --version
                        kubectl version --client
                        helm version
                    '''
                }
            }
        }
        
        stage('AWS Authentication') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
                            export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}"
                            
                            echo "Updating kubeconfig for EKS cluster..."
                            aws eks update-kubeconfig \
                                --region ${AWS_REGION} \
                                --name ${EKS_CLUSTER_NAME} \
                                --kubeconfig ${KUBECONFIG}
                            
                            export KUBECONFIG=${KUBECONFIG}
                            kubectl cluster-info
                        '''
                    }
                }
            }
        }
        
        stage('Create Namespaces') {
            steps {
                script {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG}
                        
                        echo "Creating Kubernetes namespaces..."
                        kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
                        kubectl create namespace karpenter --dry-run=client -o yaml | kubectl apply -f -
                        kubectl create namespace keda --dry-run=client -o yaml | kubectl apply -f -
                        
                        kubectl get namespaces
                    '''
                }
            }
        }
        
        stage('Deploy Karpenter') {
            when {
                expression { !params.SKIP_KARPENTER }
            }
            steps {
                script {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG}
                        
                        echo "Deploying Karpenter..."
                        helm upgrade --install karpenter ./helm/karpenter \
                            --namespace karpenter \
                            --create-namespace \
                            --set settings.aws.clusterName=${EKS_CLUSTER_NAME} \
                            --wait \
                            --timeout 5m
                        
                        echo "Waiting for Karpenter deployment..."
                        kubectl rollout status deployment/karpenter -n karpenter --timeout=5m
                    '''
                }
            }
        }
        
        stage('Deploy KEDA') {
            when {
                expression { !params.SKIP_KEDA }
            }
            steps {
                script {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG}
                        
                        echo "Deploying KEDA..."
                        helm upgrade --install keda ./helm/keda \
                            --namespace keda \
                            --create-namespace \
                            --wait \
                            --timeout 5m
                        
                        echo "Waiting for KEDA deployment..."
                        kubectl rollout status deployment/keda -n keda --timeout=5m
                    '''
                }
            }
        }
        
        stage('Deploy ArgoCD') {
            when {
                expression { !params.SKIP_ARGOCD }
            }
            steps {
                script {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG}
                        
                        echo "Deploying ArgoCD..."
                        helm upgrade --install argocd ./helm/argocd \
                            --namespace argocd \
                            --create-namespace \
                            --wait \
                            --timeout 5m
                        
                        echo "Waiting for ArgoCD deployment..."
                        kubectl rollout status deployment/argocd-server -n argocd --timeout=5m
                    '''
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                script {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG}
                        
                        echo "========== DEPLOYMENT STATUS =========="
                        echo ""
                        echo "Karpenter:"
                        kubectl get deployments -n karpenter || echo "Not deployed"
                        
                        echo ""
                        echo "KEDA:"
                        kubectl get deployments -n keda || echo "Not deployed"
                        
                        echo ""
                        echo "ArgoCD:"
                        kubectl get deployments -n argocd || echo "Not deployed"
                        
                        echo ""
                        echo "========== SERVICES =========="
                        echo ""
                        echo "ArgoCD Service (Port-forward to 8080):"
                        kubectl get svc -n argocd
                        
                        echo ""
                        echo "========== POD STATUS =========="
                        kubectl get pods -A | grep -E "argocd|karpenter|keda" || echo "No pods found"
                    '''
                }
            }
        }
    }
    
    post {
        always {
            sh 'rm -f ${KUBECONFIG}'
        }
        success {
            echo "✅ Deployment to ${params.DEPLOY_ENV} completed successfully"
            // Add notification here (Slack, email, etc.)
        }
        failure {
            echo "❌ Deployment to ${params.DEPLOY_ENV} failed"
            // Add notification here
        }
    }
}
